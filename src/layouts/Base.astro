---
import '../styles/site.css';
import BrandMark from '../components/BrandMark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomepageSearch from '../components/HomepageSearch.astro';
import ThemeControl from '../components/ThemeControl.astro';
import HeroViewport from '../components/HeroViewport.astro';
interface Props { title: string; description?: string; homepageHero?: boolean; sampleContent?: boolean; socialMetadata?: boolean }
const { title, homepageHero = false, sampleContent = true, socialMetadata = false, description = 'Built Signal development template. Clearly labeled sample content.' } = Astro.props;
const noindex = import.meta.env.PUBLIC_NOINDEX !== 'false';
const nav = [['/', 'Home'], ['/about/', 'About'], ['/writing/', 'Writing'], ['/projects/', 'Projects'], ['/mentorship/', 'Mentorship'], ['/contact/', 'Contact']];
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ben Davis Builds</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    {socialMetadata && <>
      <meta property="og:type" content="website" />
      <meta property="og:title" content={`${title} · Ben Davis Builds`} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:site_name" content="Ben Davis Builds" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content={`${title} · Ben Davis Builds`} />
      <meta name="twitter:description" content={description} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/identity/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/identity/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/identity/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/identity/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <script is:inline>
      (() => {
        let preference = 'dark';
        try { const saved = localStorage.getItem('built-signal-theme'); if (['dark', 'light', 'system'].includes(saved)) preference = saved; } catch {}
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = preference === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : preference;
      })();
    </script>
  </head>
  <body class:list={[{ homepage: homepageHero }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="development-notice"><span class="notice-label">Development preview</span><span>{sampleContent ? 'Sample content · design in progress' : 'Sample content elsewhere · design in progress'}</span></div>
    <header class:list={["site-header", "shell", { "homepage-header": homepageHero }]}>
      <a class="wordmark" href="/" aria-label="Ben Davis Builds home"><BrandMark /><span class="wordmark-type"><strong>Ben Davis</strong><small>BEN DAVIS BUILDS</small></span></a>
      <nav aria-label="Main navigation"><ul>{nav.map(([href, label]) => <li><a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href!)) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
      {homepageHero && <HomepageSearch />}
      <ThemeControl />
    </header>
    {homepageHero && <HeroViewport />}
    <main id="main" class:list={["shell", { "homepage-main": homepageHero }]} tabindex="-1"><slot /></main>
    <SiteFooter sampleContent={sampleContent} />
    <script>
      const control = document.querySelector<HTMLDetailsElement>('.theme-control');
      const trigger = control?.querySelector<HTMLElement>('summary');
      const choices = control?.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
      const media = window.matchMedia('(prefers-color-scheme: light)');
      type Theme = 'dark' | 'light' | 'system';
      let preference = (document.documentElement.dataset.themePreference || 'dark') as Theme;
      function applyTheme() {
        const theme = preference === 'system' ? (media.matches ? 'light' : 'dark') : preference;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePreference = preference;
        choices?.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === preference)));
        if (trigger) trigger.title = `Appearance: ${preference}${preference === 'system' ? ` (${theme})` : ''}`;
      }
      if (control && trigger && choices) {
        applyTheme();
        control.hidden = false;
        choices.forEach(button => button.addEventListener('click', () => {
          const selected = button.dataset.themeChoice;
          if (selected !== 'dark' && selected !== 'light' && selected !== 'system') return;
          preference = selected;
          try { localStorage.setItem('built-signal-theme', preference); } catch {}
          applyTheme();
          control.open = false;
          trigger.focus();
        }));
        control.addEventListener('keydown', event => {
          if (event.key === 'Escape' && control.open) {
            event.preventDefault();
            control.open = false;
            trigger.focus();
          }
        });
        document.addEventListener('click', event => {
          if (event.target instanceof Node && !control.contains(event.target)) control.open = false;
        });
        media.addEventListener('change', () => { if (preference === 'system') applyTheme(); });
      }
    </script>
  </body>
</html>

<style>
  .homepage-main { width: 100%; }
  .homepage-header { min-height: 112px; gap: 1rem; }
  .homepage-header :global(.theme-control[hidden]) { display: flex !important; visibility: hidden; }
  .homepage-header :global(.brand-mark) { width: 3.5rem; }
  @media (max-width:700px) { .homepage-header { gap: .75rem; } .homepage-header :global(.brand-mark) { width: 2.5rem; } }
</style>
