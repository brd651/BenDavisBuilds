---
import tokens from '../../built_signal_v1/design/built-signal.tokens.json';
const path = Astro.url.pathname;
const destinations = [
  { href: '/about/', label: 'About Me' },
  { href: '/leadership/', label: 'Leadership' },
  { href: '/writing/', label: 'Writing', children: [['/writing/', 'All Writing'], ['/writing/archive/', 'Historical Archive'], ['/writing/search/', 'Search Articles']] },
  { href: '/projects/', label: 'Projects', children: [['/projects/', 'All Projects'], ['/lab/', 'Homelab']] },
  { href: '/mentorship/', label: 'Mentorship' },
  { href: '/contact/', label: 'Contact' },
];
---
<div class="navigation-group" style={{ '--navigation-ember': tokens.optionalHistoricalAccent.classicEmber }}>
  <button class="mobile-navigation-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>Menu <span aria-hidden="true">☰</span></button>
  <nav id="primary-navigation" aria-label="Main navigation">
    <ul class="primary-links">{destinations.map(({href, label, children}) => <li class="navigation-item">
      <a href={href} aria-current={path === href ? 'page' : undefined} class:list={{ 'active-section': path.startsWith(href) }}>{label}</a>
      {children && <details class="navigation-dropdown">
        <summary aria-label={`${label} options`} aria-controls={`${label.toLowerCase()}-destinations`}><svg class="navigation-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg></summary>
        <ul class="dropdown-links" data-theme="dark" id={`${label.toLowerCase()}-destinations`}>{children.map(([url, name]) => <li><a href={url} aria-current={path === url ? 'page' : undefined}>{name}</a></li>)}</ul>
      </details>}
    </li>)}</ul>
  </nav>
</div>
<script>
  const group = document.querySelector<HTMLElement>('.navigation-group');
  const toggle = group?.querySelector<HTMLButtonElement>('.mobile-navigation-toggle');
  const nav = group?.querySelector<HTMLElement>('nav');
  const mobile = matchMedia('(max-width: 1100px)');
  const dropdowns = Array.from(group?.querySelectorAll<HTMLDetailsElement>('.navigation-dropdown') ?? []);
  function closeDropdowns() { dropdowns.forEach(dropdown => { dropdown.open = false; dropdown.querySelector('summary')?.setAttribute('aria-expanded', 'false'); }); }
  function setMenu(open: boolean) {
    if (!toggle || !nav) return;
    group!.dataset.menuOpen = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    nav.hidden = mobile.matches && !open;
    if (!open) closeDropdowns();
  }
  if (group && toggle && nav) {
    toggle.hidden = !mobile.matches;
    setMenu(false);
    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    mobile.addEventListener('change', () => { toggle.hidden = !mobile.matches; setMenu(false); });
    dropdowns.forEach(dropdown => {
      const summary = dropdown.querySelector('summary')!;
      summary.setAttribute('aria-expanded', String(dropdown.open));
      dropdown.addEventListener('toggle', () => {
        summary.setAttribute('aria-expanded', String(dropdown.open));
        if (dropdown.open) dropdowns.filter(other => other !== dropdown).forEach(other => { other.open = false; });
      });
      dropdown.addEventListener('keydown', event => {
        if (event.key === 'Escape' && dropdown.open) {
          event.preventDefault(); event.stopPropagation(); dropdown.open = false;
          summary.setAttribute('aria-expanded', 'false'); summary.focus();
        }
      });
      dropdown.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && !dropdown.contains(event.relatedTarget)) { dropdown.open = false; summary.setAttribute('aria-expanded', 'false'); }
      });
    });
    group.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobile.matches && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); setMenu(false); toggle.focus(); }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node) {
        dropdowns.forEach(dropdown => { if (!dropdown.contains(event.target as Node)) { dropdown.open = false; dropdown.querySelector('summary')?.setAttribute('aria-expanded', 'false'); } });
        if (!group.contains(event.target)) setMenu(false);
      }
    });
    group.addEventListener('focusout', event => { if (event.relatedTarget instanceof Node && !group.contains(event.relatedTarget)) setMenu(false); });
  }
</script>
<style>
  .navigation-group { min-width: 0; }
  .primary-links { align-items: center; gap: .25rem 1.125rem; }
  .navigation-item { display: flex; align-items: center; gap: 6px; position: relative; }
  .primary-links .navigation-item > a { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0; white-space: nowrap; font-size: .875rem; font-weight: 500; line-height: 1.25; color: var(--bs-muted); text-decoration: none; }
  .primary-links .navigation-item > a:hover,
  .primary-links .navigation-item > a:focus-visible,
  .primary-links .navigation-item > a.active-section { color: var(--bs-text); text-decoration: none; }
  .navigation-item > a.active-section::after { content: ''; position: absolute; left: 0; right: 0; bottom: 5px; height: 2px; background: var(--navigation-ember); }
  .navigation-dropdown summary { display: flex; align-items: center; width: 24px; min-height: 44px; padding: 0; color: var(--bs-muted); cursor: pointer; list-style: none; border-radius: 3px; }
  summary::-webkit-details-marker { display: none; }
  .navigation-dropdown summary:hover,
  .navigation-dropdown summary:focus-visible,
  .navigation-dropdown[open] summary { color: var(--bs-text); }
  .navigation-chevron { display: block; width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 140ms ease; }
  .navigation-dropdown[open] .navigation-chevron { transform: rotate(180deg); }
  .dropdown-links { display: block; position: absolute; top: calc(100% + 6px); left: 0; min-width: 14rem; padding: .5rem; margin: 0; background: var(--bs-surface); color: var(--bs-text); border: 1px solid var(--bs-line); border-radius: 6px; z-index: 30; box-shadow: 0 8px 24px color-mix(in srgb, var(--bs-page) 35%, transparent); }
  .dropdown-links li + li { margin-top: 2px; }
  .dropdown-links li a { display: flex; align-items: center; width: 100%; min-height: 44px; padding: .65rem .75rem; border-radius: 3px; font-size: .875rem; font-weight: 500; line-height: 1.4; color: var(--bs-muted); text-decoration: none; }
  .dropdown-links li a:hover,
  .dropdown-links li a:focus-visible,
  .dropdown-links li a[aria-current="page"] { color: var(--bs-text); background: color-mix(in srgb, var(--bs-raised) 65%, transparent); text-decoration: none; }
  .dropdown-links li a[aria-current="page"] { box-shadow: inset 2px 0 var(--navigation-ember); }
  .dropdown-links a:focus-visible { outline: 2px solid var(--bs-focus); outline-offset: -2px; }
  .mobile-navigation-toggle { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .5rem .75rem; font: inherit; font-size: .875rem; font-weight: 500; color: var(--bs-text); background: var(--bs-page); border: 1px solid var(--bs-border); border-radius: 3px; cursor: pointer; }
  @media (max-width: 1100px) {
    :global([data-navigation-enhanced]) .mobile-navigation-toggle[hidden] { display: inline-flex !important; }
    :global([data-navigation-enhanced]) .navigation-group:not([data-menu-open="true"]) nav { display: none; }
    .navigation-group { width: 100%; order: 4; }
    #primary-navigation { position: relative; }
    .primary-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .5rem 1rem; padding-top: .75rem; }
    .primary-links .navigation-item > a { white-space: normal; min-width: 0; }
    .dropdown-links { max-width: calc(100vw - 2rem); }
    .navigation-item:nth-child(3n) .dropdown-links { left: auto; right: 0; }
    .navigation-item { position: static; flex-wrap: wrap; align-content: start; }
  }
  @media (max-width: 550px) {
    .primary-links { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .navigation-item:nth-child(3n) .dropdown-links { left: 0; right: auto; }
    .navigation-item:nth-child(even) .dropdown-links { left: auto; right: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .navigation-chevron { transition: none; } }
  @media (forced-colors: active) {
    .navigation-item > a.active-section::after { background: Highlight; }
    .dropdown-links { border-color: CanvasText; }
    .dropdown-links li a[aria-current="page"] { border-left: 2px solid Highlight; }
  }
</style>
