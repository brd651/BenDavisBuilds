---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import HomepageHero from '../components/HomepageHero.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import CurrentMotion from '../components/homepage/CurrentMotion.astro';
import ReadingCard from '../components/homepage/ReadingCard.astro';
import { homepageContent } from '../data/homepage';
---
<Base title="Built Signal" description="Leading teams, building things, and sharing what I learn. Technical leadership, hands-on experiments, and field notes from Ben Davis." homepageHero sampleContent={false} socialMetadata>
  <HomepageHero />
  <div class="shell home-editorial">
    <section class="home-section" aria-labelledby="explore-heading">
      <header class="section-intro"><p class="eyebrow">01 / Explore</p><h2 id="explore-heading">Different paths.<br />The same curiosity.</h2></header>
      <div class="explore-grid">
        <Card title="Help people own the next decision." description="Coaching, trust, and clear accountability give people room to think and teams the confidence to execute independently." href="/leadership/" label="Leadership" />
        <Card title="Build it. Break it. Understand it." description="Networking, security, AI, and automation make more sense when you can experiment, recover, and try again." href="/projects/" label="Homelab" />
        <Card title="Write down what the work teaches you." description="Lessons, decisions, and observations from engineering and leadership. A place to work through an idea and keep what’s useful." href="/writing/" label="Writing / Field Notes" />
      </div>
    </section>
    <section class="home-section" aria-labelledby="workbench-heading">
      <header class="section-intro"><p class="eyebrow">02 / On the workbench</p><h2 id="workbench-heading">What I'm working through.</h2></header>
      <div class="workbench-grid">
        <article class="workbench-feature"><ProjectArtwork /><div class="workbench-copy"><p class="eyebrow">Technical project / Homelab</p><h3>Building an enterprise you can safely break.</h3><p>The goal is an isolated, recoverable, repeatable homelab for cybersecurity experiments and automation. Build the recovery path into the work, then use it to test the next idea.</p><a href="/projects/">Explore the project direction <span aria-hidden="true">→</span></a></div></article>
        <article class="workbench-feature"><ProjectArtwork variant="notes" /><div class="workbench-copy"><p class="eyebrow">Leadership thinking</p><h3>Does it scale? The question behind the decision.</h3><p>A customer need is real. So are technical integrity, team capacity, and the expectations a decision creates. I use this question to work through the tradeoffs and what we can repeat over time.</p><a href="/leadership/#the-operating-question-does-it-scale">Explore the leadership philosophy <span aria-hidden="true">→</span></a></div></article>
      </div>
    </section>
    <section class="home-section" aria-labelledby="motion-heading">
      <header class="section-intro"><p class="eyebrow">03 / Currently in motion</p><h2 id="motion-heading">What has my attention.</h2></header>
      <CurrentMotion />
    </section>
    <section class="home-section human-section" aria-labelledby="human-heading">
      <div><p class="eyebrow">04 / The human side</p><h2 id="human-heading">Curiosity doesn't switch off.</h2><p class="human-intro">There’s usually another question to follow. A personal project, a useful book, or a practical experiment gives me another way to understand how things work. I like keeping some room for that.</p></div>
      <ReadingCard reading={homepageContent.reading} />
    </section>
  </div>
</Base>
<style>
  .home-section { padding-block: clamp(2.75rem, 5vw, 4.5rem); border-bottom: 1px solid var(--bs-line); }
  .home-section:first-child { padding-top: clamp(40px, 2svh, 48px); }
  .home-section:last-child { border-bottom: 0; }
  .section-intro { margin-bottom: 2rem; }
  .section-intro .eyebrow, .human-section .eyebrow { margin-bottom: 1rem; }
  h2 { max-width: 25ch; margin-bottom: 0; text-wrap: balance; }
  .explore-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .explore-grid :global(.card) { padding: 1.5rem 0 0; border: 0; border-top: 1px solid var(--bs-line); border-radius: 0; background: none; }
  .explore-grid :global(.card h3) { font-size: clamp(1.35rem, 2vw, 1.65rem); line-height: 1.25; max-width: 21ch; }
  .explore-grid :global(.card p:last-child) { margin-bottom: 0; }
  .workbench-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3rem); }
  .workbench-feature { min-width: 0; }
  .workbench-feature :global(.project-artwork) { border: 1px solid var(--bs-line); border-radius: 4px; overflow: hidden; }
  .workbench-copy { padding-top: 1.5rem; }
  .workbench-copy h3 { font-size: clamp(1.65rem, 2.3vw, 2.1rem); line-height: 1.2; max-width: 27ch; }
  .workbench-copy p:not(.eyebrow), .human-intro { color: var(--bs-muted); max-width: 58ch; }
  .human-section { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .human-section h2 { margin-bottom: 1.5rem; }
  .human-intro { margin-bottom: 0; }
  @media (max-width: 700px) { .explore-grid, .workbench-grid, .human-section { grid-template-columns: 1fr; } .explore-grid { gap: 1.75rem; } }
</style>
