{
  "name": "built-signal-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:content && npm run test:release && npm run test:browser",
    "test:release": "python3 scripts/test-release.py",
    "test:browser": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "validate:tokens": "python3 built_signal_v1/verification/check_tokens.py",
    "validate:budget": "node scripts/check-js-budget.mjs",
    "verify": "npm run validate:tokens && npm run check && npm run build && npm run validate:budget && npm run test",
    "assets:identity": "node scripts/generate-identity.mjs",
    "test:unit": "node --test tests/publishing-unit.ts",
    "test:content": "node scripts/test-publishing.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.19.0"
}
