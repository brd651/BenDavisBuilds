---
import Page from '../layouts/Page.astro';
const enabled=import.meta.env.PUBLIC_GO_SERVICES_ENABLED==='true' && import.meta.env.PUBLIC_CONTACT_ENABLED==='true';
---
<Page title="Start with a good question." intro="A question, a project, or a conversation about leadership and mentorship.">
  <div class="editorial-grid"><section class="prose" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Get in touch.</h2>
    <p>Your name, email and message are used to reply. They are not included in analytics. Please leave out confidential information.</p>
    {enabled ? <>
      <form id="contact-form" hidden>
        <label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required />
        <label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
        <label for="contact-category">About</label><select id="contact-category" name="category"><option value="general">General question</option><option value="leadership">Leadership</option><option value="project">A project</option><option value="mentorship">Mentorship</option></select>
        <label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="7" minlength="10" maxlength="5000" required></textarea>
        <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <p class="fine-print">Sending runs a short browser verification. No third-party CAPTCHA loads while you read.</p>
        <button class="button primary" type="submit">Verify and send</button>
      </form>
      <p id="contact-status" role="status">JavaScript is required for browser verification. No message has been sent.</p>
      <script>import '../scripts/contact';</script>
    </> : <p role="status">Contact form delivery is awaiting configuration. You can email <a href="mailto:hello@bendavisbuilds.com">hello@bendavisbuilds.com</a>.</p>}
  </section><aside class="editorial-aside"><h2>Other places to begin</h2><ul class="detail-list"><li><a class="text-link" href="/about/">About Me →</a><span>The people and systems behind the work.</span></li><li><a class="text-link" href="/mentorship/">Mentorship →</a><span>A place to start the conversation.</span></li><li><a class="text-link" href="/projects/">Projects →</a><span>Experiments and practical work.</span></li></ul></aside></div>
</Page>
<style>
  form { display: grid; gap: .6rem; margin-block: 1.5rem; }
  label { font-weight: 600; margin-top: .5rem; }
  input,select,textarea { width: 100%; min-width: 0; min-height: 44px; font: inherit; color: var(--bs-text); background: var(--bs-surface); border: 1px solid var(--bs-border); border-radius: 3px; padding: .65rem .75rem; }
  textarea { resize: vertical; }
  .contact-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  button { width: fit-content; cursor: pointer; }
  button:disabled { opacity: .7; cursor: wait; }
  #contact-status { margin-top: 1rem; }
</style>
