---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const philosophy = await getEntry('leadership', 'philosophy');
if (!philosophy || philosophy.data.draft) throw new Error('Leadership copy must be present and approved for publication.');
const { Content } = await render(philosophy);
const contents = [
  ['#principles', 'Five principles'],
  ['#the-operating-question-does-it-scale', 'Does It Scale?'],
  ['#technical-integrity-and-business-outcomes', 'In practice'],
  ['#leadership-transparency', 'No Surprises'],
  ['#leadership-success', 'What success looks like'],
];
---
<Base title={philosophy.data.title} description={philosophy.data.description} sampleContent={false} socialMetadata>
  <article class="leadership-page">
    <header class="leadership-heading">
      <p class="eyebrow signature-label">Leadership philosophy</p>
      <h1>{philosophy.data.title}</h1>
      <p class="lead">{philosophy.data.subtitle}</p>
      <nav class="leadership-contents" aria-label="On this page">
        <ul>{contents.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    </header>
    <div class="leadership-prose"><Content /></div>
    <nav class="leadership-more" aria-label="Continue exploring">
      <a class="text-link" href="/about/">About Ben →</a>
      <a class="text-link" href="/mentorship/">Mentorship →</a>
    </nav>
  </article>
</Base>

<style>
  /* Long editorial anchor jumps stay deterministic during rapid keyboard navigation. */
  :global(html:has(.leadership-page)) { scroll-behavior: auto; }
  .leadership-page { margin-bottom: 5rem; }
  .leadership-heading { border-top: 1px solid var(--bs-line); padding-block: clamp(2rem, 5vw, 4rem) 2.5rem; }
  .leadership-heading .eyebrow { margin-bottom: 1.5rem; }
  .leadership-heading h1 { font-size: clamp(2.75rem, 5vw, 4.5rem); margin-bottom: 1.25rem; }
  .leadership-heading .lead { max-width: 48ch; font-size: clamp(1.125rem, 1.5vw, 1.375rem); }
  .leadership-contents { margin-top: 2rem; }
  .leadership-contents ul { gap: .5rem 2rem; }
  .leadership-contents a { display: inline-block; padding-block: .4rem; font-size: .875rem; }
  .leadership-prose { min-width: 0; }
  .leadership-prose :global(p), .leadership-prose :global(.framework-questions) { font-size: 1.125rem; line-height: 1.8; }
  .leadership-prose :global(.leadership-section) { padding-block: clamp(2rem, 5vw, 4rem); border-top: 1px solid var(--bs-line); }
  .leadership-prose :global([id]) { scroll-margin-top: 2rem; }
  .leadership-prose :global(h2) { font-size: clamp(1.8rem, 3vw, 2.75rem); line-height: 1.2; margin-bottom: 2rem; max-width: 25ch; }
  .leadership-prose :global(h3) { font-size: clamp(1.3rem, 2vw, 1.65rem); line-height: 1.35; letter-spacing: -.025em; }
  .leadership-prose :global(.eyebrow) { font-size: .75rem; line-height: 1.6; }
  .leadership-prose :global(.principle-overview ol) { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .8rem; list-style: none; padding: 0; margin: 0; }
  .leadership-prose :global(.principle-card) { display: flex; flex-direction: column; height: 100%; gap: .8rem; padding: 1.25rem; border: 1px solid var(--bs-line); border-radius: 4px; background: var(--bs-surface); text-decoration: none; transition: border-color 150ms ease; }
  .leadership-prose :global(.principle-card:hover) { background: var(--bs-raised); border-color: var(--bs-border); }
  .leadership-prose :global(.principle-card:hover .principle-link) { text-decoration-thickness: 2px; }
  .leadership-prose :global(.principle-number) { font-size: .875rem; color: var(--bs-accentText); font-variant-numeric: tabular-nums; letter-spacing: .08em; }
  .leadership-prose :global(.principle-card strong) { font-size: 1.0625rem; line-height: 1.4; }
  .leadership-prose :global(.principle-summary) { font-size: .9375rem; line-height: 1.65; color: var(--bs-muted); }
  .leadership-prose :global(.principle-link) { padding-top: .5rem; margin-top: auto; font-size: .875rem; line-height: 1.5; text-decoration: underline; text-underline-offset: .22em; }
  .leadership-prose :global(.leadership-intro) { max-width: 65ch; margin-block: 3rem; }
  .leadership-prose :global(.leadership-chapter) { display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); column-gap: clamp(2rem, 5vw, 4rem); padding-top: 2.5rem; margin-top: 2.5rem; border-top: 1px solid var(--bs-line); }
  .leadership-prose :global(.leadership-chapter h3) { grid-column: 1; grid-row: 1; }
  .leadership-prose :global(.leadership-chapter p) { grid-column: 2; max-width: 65ch; }
  .leadership-prose :global(.leadership-related) { font-size: .9375rem; }
  .leadership-prose :global(.leadership-operating) { padding: clamp(1.25rem, 4vw, 3rem); background: var(--bs-surface); border: 1px solid var(--bs-line); border-top: 2px solid var(--bs-brass); border-radius: 5px; margin-block: 1rem 3rem; }
  .leadership-prose :global(.leadership-operating h2) { color: var(--bs-accentText); }
  .leadership-prose :global(.framework-layout) { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 3rem; align-items: start; }
  .leadership-prose :global(.framework-questions ol) { padding-left: 1.5rem; margin: 0; }
  .leadership-prose :global(.framework-questions li) { padding: 1rem 0 1rem .5rem; border-top: 1px solid var(--bs-line); }
  .leadership-prose :global(.framework-questions li:first-child) { padding-top: 0; border-top: 0; }
  .leadership-prose :global(.framework-questions li::marker) { font-weight: 700; color: var(--bs-accentText); }
  .leadership-prose :global(.framework-questions strong) { display: block; }
  .leadership-prose :global(.framework-closing) { max-width: 65ch; border-top: 1px solid var(--bs-line); margin-top: 2rem; padding-top: 2rem; }
  .leadership-prose :global(.practice-intro), .leadership-prose :global(.transparency-copy), .leadership-prose :global(.leadership-success) { max-width: 65ch; }
  .leadership-prose :global(.leadership-case) { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); column-gap: 3rem; padding: clamp(1.25rem, 4vw, 2.5rem); margin-block: 2rem; border: 1px solid var(--bs-line); border-radius: 5px; background: var(--bs-surface); }
  .leadership-prose :global(.leadership-case h3) { grid-column: 1; font-size: 1.125rem; padding-top: .3rem; }
  .leadership-prose :global(.leadership-case p) { grid-column: 2; max-width: 65ch; }
  .leadership-prose :global(.leadership-coaching) { max-width: 65ch; margin-top: 3rem; padding: clamp(1.25rem, 3vw, 2rem); border-left: 3px solid var(--bs-border); background: var(--bs-surface); }
  .leadership-prose :global(.transparency-copy p:nth-child(2)) { border-left: 3px solid var(--bs-border); padding: 1.5rem; background: var(--bs-surface); }
  .leadership-prose :global(.leadership-success) { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--bs-line); }
  .leadership-more { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-top: 2rem; border-top: 1px solid var(--bs-line); }
  @media (max-width: 1100px) {
    .leadership-prose :global(.principle-overview ol) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .leadership-prose :global(.principle-overview li:last-child) { grid-column: 1 / -1; }
  }
  @media (max-width: 800px) {
    .leadership-prose :global(.leadership-chapter), .leadership-prose :global(.framework-layout), .leadership-prose :global(.leadership-case) { grid-template-columns: minmax(0, 1fr); }
    .leadership-prose :global(.leadership-chapter p), .leadership-prose :global(.leadership-case p) { grid-column: 1; }
    .leadership-prose :global(.framework-layout) { gap: 1.5rem; }
    .leadership-prose :global(.leadership-case h3:not(:first-child)) { padding-top: 1rem; border-top: 1px solid var(--bs-line); }
  }
  @media (max-width: 600px) {
    .leadership-prose :global(.principle-overview ol) { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .leadership-prose :global(.principle-card) { transition: none; }
  }
  @media (forced-colors: active) {
    .leadership-prose :global(.principle-card), .leadership-prose :global(.leadership-operating), .leadership-prose :global(.leadership-case) { border-color: CanvasText; }
  }
</style>
