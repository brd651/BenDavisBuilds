const currents = [
  { index: 2, duration: '29.3s', delay: '-8.7s', span: 38 },
  { index: 8, duration: '33.1s', delay: '-23.4s', span: 48 },
  { index: 15, duration: '24.9s', delay: '-15.2s', span: 32 },
  { index: 20, duration: '31.7s', delay: '-3.6s', span: 42 },
