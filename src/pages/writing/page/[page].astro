---
import WritingLanding from '../../../components/publishing/WritingLanding.astro';
import { publishedEntries } from '../../../lib/publishing';
import { latestWritingEntries, pageCount } from '../../../lib/publishing-policy';
export async function getStaticPaths() { const entries = await publishedEntries('writing'); return Array.from({ length: pageCount(latestWritingEntries(entries).length) - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { entries, page: i + 2 } })); }
const { entries, page } = Astro.props;
---
<WritingLanding entries={entries} page={page} />
