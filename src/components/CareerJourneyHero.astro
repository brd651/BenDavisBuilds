---
// Abstract ribbons of time, not real terrain, dates, or operational telemetry.
const currents = Array.from({ length: 19 }, (_, i) => {
  const y = 285 + i * 4;
  return `M-18 ${y}C95 ${y + 85} 126 ${90 + i * 8} 270 ${193 + i * 1.8}S411 ${390 - i * 8} 586 ${76 + i * 5}`;
});
const route = 'M-18 321C95 406 126 162 270 209S411 318 586 121';
---
<figure class="journey-art" aria-hidden="true" data-journey-flow>
  <svg viewBox="0 0 560 420" fill="none">
    <defs>
      <linearGradient id="journey-ink" x1="0" y1="340" x2="560" y2="100" gradientUnits="userSpaceOnUse"><stop stop-color="var(--bs-brass)" stop-opacity=".15"/><stop offset=".42" stop-color="var(--bs-accentText)"/><stop offset=".72" stop-color="var(--bs-text)" stop-opacity=".65"/><stop offset="1" stop-color="var(--bs-brass)" stop-opacity=".12"/></linearGradient>
      <radialGradient id="journey-atmosphere"><stop stop-color="var(--bs-brass)" stop-opacity=".14"/><stop offset="1" stop-color="var(--bs-brass)" stop-opacity="0"/></radialGradient>
      <clipPath id="journey-crop"><path d="M0 0H560V420H0Z"/></clipPath>
    </defs>
    <circle cx="290" cy="220" r="195" fill="url(#journey-atmosphere)"/>
    <g class="time-dial">
      <circle cx="285" cy="210" r="159"/><circle cx="285" cy="210" r="171"/>
      {Array.from({ length: 36 }, (_, i) => <path d="M285 34V40" transform={`rotate(${i * 10} 285 210)`} />)}
      <path class="dial-accent" d="M126 210A159 159 0 0 1 285 51"/>
    </g>
    <g clip-path="url(#journey-crop)">
      <g class="currents">{currents.map((d, i) => <path d={d} style={`opacity:${.2 + (1 - Math.abs(i - 9) / 10) * .65}`} />)}</g>
      <path class="flow-spine" d={route}/>
      <g class="flow-highlights">{[3, 9, 15].map((i, n) => <path d={currents[i]} pathLength="1000" style={`--phase:${n * 210}; --delay:${n * .2}s`} />)}</g>
    </g>
    <g class="waypoints"><circle cx="84" cy="312" r="5"/><circle cx="279" cy="210" r="6"/><circle cx="467" cy="227" r="5"/></g>
    <path class="registration" d="M29 277V262H44 M502 65H517V80 M250 391H310"/>
  </svg>
  <figcaption><span>Service</span><span>Engineering</span><span>Leadership</span></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey-flow]').forEach(art => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const update = () => {
      frame = 0;
      if (reduced.matches) { art.style.removeProperty('--flow-progress'); return; }
      const bounds = art.getBoundingClientRect();
      // No idle loop: after the one-shot introduction, only scrolling advances time.
      if (bounds.bottom < 0 || bounds.top > innerHeight) return;
      art.style.setProperty('--flow-progress', String(Math.min(1, Math.max(0, scrollY / innerHeight))));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('pageshow', schedule);
    reduced.addEventListener('change', schedule);
    schedule();
  });
</script>

<style>
  .journey-art { margin: 0; min-width: 0; position: relative; }
  svg { display: block; width: 100%; height: auto; }
  .time-dial { stroke: var(--bs-border); stroke-width: .75; opacity: .32; }
  .time-dial .dial-accent { stroke: var(--bs-brass); stroke-width: 2; }
  .currents { stroke: url(#journey-ink); stroke-width: 1.2; }
  .flow-spine { stroke: var(--bs-accentText); stroke-width: 1.5; opacity: .55; }
  .flow-highlights { stroke: var(--bs-text); stroke-width: 1.7; opacity: .8; }
  .flow-highlights path { stroke-dasharray: 55 945; stroke-dashoffset: calc(var(--phase) - var(--flow-progress, 0) * 1000); animation: time-passage 4s ease-out var(--delay) backwards; }
  @keyframes time-passage { from { stroke-dashoffset: calc(var(--phase) + 1000); opacity: 0; } 20% { opacity: 1; } to { stroke-dashoffset: calc(var(--phase) - var(--flow-progress, 0) * 1000); } }
  .waypoints { fill: var(--bs-page); stroke: var(--bs-accentText); stroke-width: 1.5; }
  .registration { stroke: var(--bs-brass); stroke-width: 1; opacity: .65; }
  figcaption { display: flex; justify-content: space-between; gap: .75rem; margin: .6rem .5rem 0; padding-top: 1rem; border-top: 1px solid var(--bs-line); font-size: .625rem; text-transform: uppercase; letter-spacing: .12em; color: var(--bs-muted); }
  figcaption span { white-space: nowrap; }
  @media (max-width: 900px) { figcaption { flex-direction: column; align-items: flex-start; gap: .35rem; } }
  @media (max-width: 650px) { .journey-art { display: none; } }
  @media (prefers-reduced-motion: reduce) { .flow-highlights path { animation: none; stroke-dashoffset: var(--phase); } }
  @media (forced-colors: active) { .currents, .flow-spine, .flow-highlights, .waypoints, .time-dial { stroke: CanvasText; } }
</style>
