---
<svg class="topographic-overlay" viewBox="0 0 1672 941" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`--topo-line: ${tokens.referenceSwatches.ivory}; --topo-ember: ${tokens.optionalHistoricalAccent.classicEmber}`}>
  <g class="contours">{contours.map((d, index) => <path d={d} class:list={{ 'index-contour': [2, 8, 12, 15, 20].includes(index), 'minor-contour': index % 4 === 1 }}/>)}</g>
  <g class="map-guides"><path d="M128 58V79M1546 58V79M59 133H80M59 526H80M59 791H80"/><path d="M114 67H142M1532 67H1560M68 121V145M68 514V538M68 779V803"/></g>
  <g class="registration"><path d="M1417 229H1443M1430 216V242M529 500H555M542 487V513M335 662H361M348 649V675"/><path d="M709 815H735M722 802V828M855 609H881M868 596V622"/></g>
  <g class="highlights">{currents.map(({ index, duration, delay, span }) => <g class="contour-highlight" style={`--flow-duration: ${duration}; --flow-delay: ${delay}; --flow-span: ${span}`}>
    <path class="current-halo" d={contours[index]} pathLength="1000"/>
    <path class="current-aura" d={contours[index]} pathLength="1000"/>
    <path class="current-core" d={contours[index]} pathLength="1000"/>
  </g>)}</g>
</svg>
<style>
  /* Match the photograph's cover sizing/crop instead of stretching a screen-space map. */
  .topographic-overlay {
    position: absolute;
    width: max(100cqw, calc(100cqh * 16 / 9));
    height: max(100cqh, calc(100cqw * 9 / 16));
    left: calc((100% - max(100cqw, calc(100cqh * 16 / 9))) * var(--hero-frame-x, .5));
    top: calc((100% - max(100cqh, calc(100cqw * 9 / 16))) * var(--hero-frame-y, .44));
    pointer-events: none;
    z-index: 2;
  }
  path { fill: none; stroke-width: 1.1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .contours { stroke: var(--topo-line); opacity: .38; }
  .minor-contour { stroke-dasharray: 4 5; opacity: .7; }
  .index-contour { stroke: var(--topo-ember); stroke-dasharray: 7 4; opacity: .94; }
  .map-guides { stroke: var(--topo-line); opacity: .28; }
  .registration { stroke: var(--topo-line); opacity: .32; }
  /* Unequal cycles/phases produce irregular currents; layered strokes add glow without blur filters. */
  .contour-highlight { stroke-dasharray: var(--flow-span) calc(1000 - var(--flow-span)); opacity: 0; animation: terrain-current var(--flow-duration) linear var(--flow-delay) infinite; }
  .current-halo { stroke: var(--topo-ember); stroke-width: 7; opacity: .12; }
  .current-aura { stroke: var(--bs-brass); stroke-width: 3.5; opacity: .4; }
  .current-core { stroke: var(--topo-line); stroke-width: 1.4; opacity: .95; }
  @keyframes terrain-current {
    0% { stroke-dashoffset: 1050; opacity: 0; }
    12% { opacity: .9; }
    47% { opacity: .8; }
    76%,100% { opacity: 0; }
    100% { stroke-dashoffset: -50; }
  }
  @media (max-width: 700px) { .map-guides,.registration { display: none; } .contours { opacity: .3; } .current-halo { stroke-width: 5; } }
  @media (prefers-reduced-motion: reduce) { .contour-highlight { animation: none; opacity: 0; } }
  @media (forced-colors: active) { .topographic-overlay { display: none; } }
</style>
