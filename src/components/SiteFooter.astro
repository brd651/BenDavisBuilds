---
import BrandMark from './BrandMark.astro';
import SocialIcon from './SocialIcon.astro';
import AnalyticsPreferences from './backend/AnalyticsPreferences.astro';
import { siteIdentity, socialProfiles } from '../data/site';
const year = new Date().getUTCFullYear();
const analyticsEnabled = import.meta.env.PUBLIC_GO_SERVICES_ENABLED === 'true';
---
<footer class="site-footer shell">
  <div class="footer-primary">
    <div class="footer-identity"><BrandMark class="footer-brand-mark" /><strong>{siteIdentity.name}</strong></div>
    <div class="footer-links">
      <nav class="footer-socials" aria-label="Social profiles"><ul>{socialProfiles.map(profile => <li><a class="social-profile" href={profile.href} target="_blank" rel="noopener noreferrer" aria-label={`Ben Davis on ${profile.label} (opens in a new tab)`} title={`${profile.label} (opens in a new tab)`}><SocialIcon platform={profile.platform} /></a></li>)}</ul></nav>
      <a class="footer-contact" href="/contact/">Contact</a>
    </div>
  </div>
  <div class="footer-meta">
    <p class="footer-copyright">© {year} {siteIdentity.name}</p>
    <details class="footer-privacy" id="privacy-notice"><summary>Privacy</summary><div class="privacy-copy"><p>Contact details are used to reply to your message. Form messages and email addresses are excluded from analytics.</p><p>{analyticsEnabled ? 'Optional analytics are off by default. You can change your choice in Analytics preferences at any time.' : 'Optional analytics are unavailable in this build. No analytics events are sent.'}</p></div></details>
    <AnalyticsPreferences embedded />
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--bs-line); padding-block: 1.5rem; color: var(--bs-muted); font-size: .875rem; }
  .footer-primary, .footer-links, .footer-identity { display: flex; align-items: center; }
  .footer-primary { justify-content: space-between; flex-wrap: wrap; gap: .75rem 2rem; }
  .footer-identity { gap: .65rem; color: var(--bs-text); }
  .footer-identity strong { font-size: 1rem; font-weight: 650; letter-spacing: -.025em; }
  .footer-identity :global(.footer-brand-mark) { width: 1.75rem; height: auto; }
  .footer-links { flex-wrap: wrap; gap: 1rem; }
  .footer-socials ul { display: flex; gap: .3rem; list-style: none; padding: 0; margin: 0; }
  .social-profile { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid transparent; border-radius: 4px; color: var(--bs-muted); text-decoration: none; }
  .social-profile:hover, .social-profile:focus-visible { background: var(--bs-surface); color: var(--bs-accentText); border-color: var(--bs-border); }
  .social-profile :global(svg) { display: block; width: 21px; height: 21px; }
  .footer-contact { display: inline-flex; align-items: center; min-height: 44px; padding-inline: .5rem; }
  .footer-meta { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: start; gap: .5rem 1.5rem; padding-top: .5rem; }
  .footer-copyright { margin: 0; padding-block: .5rem; min-height: 44px; font-size: .8125rem; }
  summary { cursor: pointer; min-height: 44px; padding-block: .5rem; width: fit-content; }
  .privacy-copy { max-width: 75ch; padding-block: .75rem; }
  .privacy-copy p:last-child { margin-bottom: 0; }
  .footer-privacy[open], .footer-meta :global(.analytics-preferences[open]) { grid-column: 1 / -1; }
  @media (max-width: 700px) { .footer-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; } .footer-copyright { grid-column: 1/-1; padding-bottom: 0; min-height: 0; } }
  @media (forced-colors: active) { .social-profile:hover, .social-profile:focus-visible { border-color: CanvasText; } }
</style>
