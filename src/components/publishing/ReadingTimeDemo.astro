---
interface Props { id: string }
const { id } = Astro.props;
---
<details class="reading-demo" data-reading-demo>
<summary>Optional interactive example: estimate reading time</summary>
<p data-fallback>A 440-word article takes about 2 minutes at 220 words per minute. This estimate is illustrative.</p>
<div data-controls hidden><label for={id}>Article word count</label><input id={id} type="number" min="1" max="100000" value="440" inputmode="numeric" /><p role="status" data-estimate>Estimated reading time: 2 minutes.</p></div>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-reading-demo]').forEach(example => {
    example.addEventListener('toggle', async () => {
      if (!example.open || example.dataset.loaded) return;
      example.dataset.loaded = 'loading';
      try { const { enhanceReadingDemo } = await import('../../scripts/reading-demo'); enhanceReadingDemo(example); example.dataset.loaded = 'true'; }
      catch { delete example.dataset.loaded; }
    });
  });
</script>
<style>.reading-demo { border: 1px solid var(--bs-border); padding: 1rem 1.25rem; margin: 2rem 0; background: var(--bs-surface); } summary { cursor: pointer; font-weight: 650; } p { margin-top: 1rem; } label { display: block; margin-block: 1rem .5rem; } input { max-width: 100%; width: 12rem; font: inherit; background: var(--bs-page); color: var(--bs-text); border: 1px solid var(--bs-border); padding: .5rem; } </style>
