---
import { Picture } from 'astro:assets';
import heroArtwork from '../../design/reference/hero2.png';
import TopographicOverlay from './TopographicOverlay.astro';
import tokens from '../../built_signal_v1/design/built-signal.tokens.json';
// Owner-supplied clean artwork; Astro generates fingerprinted responsive variants.
const { navy, ivory } = tokens.referenceSwatches;
---
<section class="built-hero" aria-labelledby="hero-heading" style={`--hero-navy: ${navy}; --hero-ivory: ${ivory}`}>
  <div class="hero-background" aria-hidden="true"><Picture src={heroArtwork} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280, heroArtwork.width]} sizes="(max-width: 700px) 1140px, (max-width: 1245px) 1245px, 100vw" alt="" loading="eager" decoding="async" fetchpriority="high" /></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <TopographicOverlay />
  <div class="hero-inner shell">
    <div class="hero-foreground">
      <h1 id="hero-heading">Systems for a more interesting tomorrow.</h1>
      <span class="hero-signature" aria-hidden="true"></span>
      <p class="hero-support">Technical leadership, practical systems, and real-world progress.</p>
      <div class="button-row"><a class="button primary" href="/writing/">Explore Writing <span aria-hidden="true">→</span></a><a class="button" href="/projects/">View Projects</a></div>
    </div>
    <div class="hero-hud"><svg class="hero-hud-frame" viewBox="0 0 190 240" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M24 1H12L1 12V52M1 186V228L12 239H30M166 1H178L189 12V52M189 188V228L178 239H158M1 112V127M189 112V127"/></svg><ul aria-label="Built Signal themes"><li>Build</li><li>Secure</li><li>Optimize</li><li>Explore</li></ul></div>
    <div class="hero-bottom"><ul class="hero-pillars" aria-label="Built Signal focus"><li>People</li><li>Systems</li><li>Execution</li><li>Impact</li></ul><label class="hero-motion"><input id="hero-motion-pause" type="checkbox" /><span class="motion-label">Pause contour motion</span><span class="motion-reduced">Motion off (system preference)</span></label></div>
  </div>
</section>
<style>
  .built-hero { position: relative; isolation: isolate; overflow: hidden; min-height: 700px; background: var(--bs-page); border-block: 1px solid var(--bs-line); }
  .hero-background,.hero-shade { position: absolute; inset: 0; pointer-events: none; }
  .hero-background { z-index: 0; }
  .hero-background :global(picture),.hero-background :global(img) { display: block; width: 100%; height: 100%; }
  .hero-background :global(img) { object-fit: cover; object-position: 50% 44%; }
  .hero-shade { z-index: 1; background: linear-gradient(90deg,color-mix(in srgb,var(--hero-navy) 72%,transparent),color-mix(in srgb,var(--hero-navy) 54%,transparent) 34%,color-mix(in srgb,var(--hero-navy) 20%,transparent) 56%,transparent 72%); }
  .hero-inner { position: relative; z-index: 3; min-height: inherit; padding-block: 5.5rem 2rem; display: grid; grid-template-columns: minmax(0,1fr) 190px; grid-template-rows: 1fr auto; gap: 3rem; }
  .hero-foreground { max-width: 620px; align-self: center; }
  h1 { max-width: 23ch; font-size: clamp(1.65rem,2.45vw,2.5rem); line-height: 1.7; text-transform: uppercase; letter-spacing: .2em; font-weight: 500; margin-bottom: 1.7rem; text-wrap: balance; }
  .hero-signature { display: block; width: 3rem; height: 3px; background: var(--bs-scarlet); margin-bottom: 1.6rem; }
  .hero-support { max-width: 36ch; font-size: clamp(1.125rem,1.7vw,1.55rem); line-height: 1.65; color: var(--bs-text); }
  .button-row { margin-top: 2.4rem; gap: 1rem; }
  .button { min-height: 52px; padding: .85rem 1.5rem; font-size: 1rem; background: var(--bs-page); }
  .button.primary { background: var(--bs-action); }
  .hero-hud { position: relative; isolation: isolate; margin: -2rem 0 0; list-style: none; width: 165px; padding: 1.5rem .7rem; align-self: start; justify-self: end; display: grid; gap: 1.1rem; border: 0; text-align: center; text-transform: uppercase; letter-spacing: .22em; font-size: .875rem; color: var(--hero-ivory); }
  .hero-hud::before { content: ''; position: absolute; inset: -.4rem -.6rem; z-index: -1; background: radial-gradient(ellipse,color-mix(in srgb,var(--hero-navy) 66%,transparent) 15%,color-mix(in srgb,var(--hero-navy) 44%,transparent) 65%,transparent 100%); }
  .hero-hud ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .hero-hud-frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; fill: none; stroke: var(--hero-ivory); stroke-width: 1; opacity: .48; }
  .hero-hud-frame path { vector-effect: non-scaling-stroke; }
  .hero-bottom { grid-column: 1/-1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .hero-pillars { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; list-style: none; margin: 0; padding: 0; text-transform: uppercase; letter-spacing: .2em; font-size: .8125rem; }
  .hero-pillars li+li::before { content: '/'; color: var(--bs-scarlet); margin-right: 1.5rem; }
  .hero-motion { color: var(--hero-ivory); background: color-mix(in srgb,var(--hero-navy) 70%,transparent); padding: .3rem .5rem; border-radius: 3px; display: flex; align-items: center; gap: .5rem; font-size: .8125rem; cursor: pointer; }
  .hero-motion input { width: 1.1rem; height: 1.1rem; accent-color: var(--bs-action); flex-shrink: 0; }
  .motion-reduced { display: none; }
  .built-hero:has(#hero-motion-pause:checked) :global(.contour-highlight) { animation-play-state: paused; }
  :global([data-theme="light"]) .hero-shade { background: linear-gradient(90deg,var(--bs-page),color-mix(in srgb,var(--bs-page) 96%,transparent) 34%,color-mix(in srgb,var(--bs-page) 65%,transparent) 50%,transparent 72%); }
  @media (min-width:701px) { :global([data-theme="light"]) .hero-pillars { background: color-mix(in srgb,var(--bs-page) 94%,transparent); padding: .3rem .5rem; border-radius: 2px; } }
  @media (max-width:1000px) { .hero-inner { grid-template-columns: minmax(0,1fr) 155px; gap: 2rem; padding-top: 4rem; } h1 { letter-spacing: .15em; } .hero-hud { letter-spacing: .15em; width: 145px; padding: 1rem .6rem; } .hero-hud ul { gap: .75rem; } .hero-background :global(img) { object-position: 72% center; } }
  @media (max-width:700px) { .built-hero { min-height: 640px; } .hero-inner { display: flex; flex-direction: column; justify-content: space-between; padding-block: 3rem 1.5rem; gap: 2rem; } .hero-foreground { width: 100%; } h1 { max-width: 21ch; font-size: 1.65rem; letter-spacing: .12em; line-height: 1.65; } .hero-hud { display: none; } .hero-background :global(img) { object-position: 80% center; } .hero-support { max-width: 29ch; } .hero-shade { background: linear-gradient(90deg,color-mix(in srgb,var(--hero-navy) 85%,transparent),color-mix(in srgb,var(--hero-navy) 70%,transparent) 65%,color-mix(in srgb,var(--hero-navy) 35%,transparent)); } .hero-pillars { gap: .5rem .9rem; letter-spacing: .09em; font-size: .75rem; } .hero-pillars li+li::before { margin-right: .9rem; } .hero-bottom { gap: 1.5rem; } }
  @media (max-width:700px) {
    :global([data-theme="light"]) .built-hero { display: grid; grid-template-rows: auto 250px auto; min-height: 0; }
    :global([data-theme="light"]) .hero-inner { display: contents; }
    :global([data-theme="light"]) .hero-foreground { grid-row: 1; grid-column: 1; width: calc(100% - 2rem); margin: 3rem auto 2rem; }
    :global([data-theme="light"]) .hero-background { position: relative; inset: auto; grid-row: 2; grid-column: 1; height: 250px; }
    :global([data-theme="light"]) .hero-background :global(img) { object-position: 72% 44%; }
    :global([data-theme="light"]) .hero-shade { display: none; }
    :global([data-theme="light"]) .hero-bottom { grid-row: 3; grid-column: 1; margin: 1.5rem 1rem; }
  }
  @media (prefers-reduced-motion:reduce) { .hero-motion input,.motion-label { display: none; } .motion-reduced { display: inline; } }
  @media (forced-colors:active) { .hero-background,.hero-shade { display: none; } .built-hero { border-color: CanvasText; } }
</style>
