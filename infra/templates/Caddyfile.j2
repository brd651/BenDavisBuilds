{
    # Runtime logs are bounded independently from access logs.
    log default {
        output file /var/log/caddy/runtime.log {
            roll_size 5MiB
            roll_keep 3
            roll_keep_for 168h
        }
        format json
    }
}

(static_site) {
    root * {{ site_root }}/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
{% if development_noindex | default(true) %}
        X-Robots-Tag "noindex, nofollow"
{% endif %}
        Cache-Control "no-cache"
    }
    @fingerprinted path_regexp fingerprinted ^/_astro/[^/]+\.[A-Za-z0-9_-]{8,}\.(css|js|woff2|png|webp|avif|svg)$
    header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
    log {
        output file /var/log/caddy/access.log {
            roll_size 5MiB
            roll_keep 3
            roll_keep_for 168h
        }
        format json
    }
    file_server
    handle_errors 404 {
        rewrite * /404.html
        file_server {
            status 404
        }
    }
}

{% if https_ready %}
{{ site_domain }} {
    import static_site
}
{% if www_ready %}
www.{{ site_domain }} {
    redir https://{{ site_domain }}{uri} permanent
}
{% endif %}
{% else %}
{{ preview_address }} {
    import static_site
}
{% endif %}
