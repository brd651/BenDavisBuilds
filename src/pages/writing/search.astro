---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/publishing/ArticleCard.astro';
import { publishedEntries } from '../../lib/publishing';
const entries = await publishedEntries();
---
<Base title="Search the writing." description="Search published writing, historical archive entries, and projects. A static index works without a search server." socialMetadata>
  <section class="article-search" aria-label="Article search">
    <header class="page-heading"><p class="eyebrow">Built Signal / the index</p><h1>Search the writing.</h1><p class="lead">Writing, historical entries, and projects. Demonstrations are labeled.</p></header>
    <a class="back-link" href="/writing/">← All writing</a>
    <div class="search-controls" hidden><label for="article-query">Search articles by topic, title, or text</label><input type="search" id="article-query" autocomplete="off" aria-describedby="search-status" /><p id="search-status" role="status">Enter a topic to search the static index.</p></div>
    <div class="search-results" hidden><ul aria-label="Search results"></ul></div>
    <div class="search-fallback"><p>Browse the published index below. JavaScript enables text search; reading articles never requires it.</p><div class="search-grid">{entries.map(entry => <ArticleCard entry={entry} />)}</div></div>
  </section>
</Base>
<script>
  interface IndexedArticle { url: string; title: string; description: string; category: string; tags: string[]; collection: string; sample: boolean; text: string }
  const root = document.querySelector<HTMLElement>('.article-search');
  const input = root?.querySelector<HTMLInputElement>('input');
  const status = root?.querySelector<HTMLElement>('[role="status"]');
  const list = root?.querySelector<HTMLUListElement>('.search-results ul');
  let indexPromise: Promise<IndexedArticle[]> | undefined;
  let revision = 0;
  if (root && input && status && list) {
    root.querySelector<HTMLElement>('.search-controls')!.hidden = false;
    input.addEventListener('input', async () => {
      const current = ++revision;
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (!words.length) { root.querySelector<HTMLElement>('.search-results')!.hidden = true; root.querySelector<HTMLElement>('.search-fallback')!.hidden = false; status.textContent = 'Enter a topic to search the static index.'; return; }
      status.textContent = 'Searching…';
      try {
        indexPromise ??= fetch('/search-index.json').then(async response => { if (!response.ok) throw new Error('Index unavailable'); return response.json() as Promise<IndexedArticle[]>; });
        const matches = (await indexPromise).filter(entry => words.every(word => `${entry.title} ${entry.description} ${entry.category} ${entry.tags.join(' ')} ${entry.text}`.toLowerCase().includes(word)));
        if (revision !== current) return;
        list.replaceChildren();
        for (const entry of matches.slice(0, 50)) {
          const item = document.createElement('li'); const link = document.createElement('a'); const description = document.createElement('p'); const label = document.createElement('p');
          link.href = entry.url; link.textContent = entry.title; description.textContent = entry.description; label.textContent = `${entry.collection} / ${entry.category}${entry.sample ? ' / demonstration' : ''}`; label.className = 'result-label';
          item.append(label, link, description); list.append(item);
        }
        status.textContent = `${matches.length} ${matches.length === 1 ? 'article' : 'articles'} found.${matches.length > 50 ? ' Showing the first 50.' : ''}`;
        root.querySelector<HTMLElement>('.search-results')!.hidden = false; root.querySelector<HTMLElement>('.search-fallback')!.hidden = true;
      } catch { indexPromise = undefined; if (revision !== current) return; status.textContent = 'Search is temporarily unavailable. Browse the published index below.'; root.querySelector<HTMLElement>('.search-results')!.hidden = true; root.querySelector<HTMLElement>('.search-fallback')!.hidden = false; }
    });
  }
</script>
<style>
.article-search { margin-bottom: 5rem; } .search-controls { max-width: 800px; margin-bottom: 2rem; } label { display: block; font-weight: 600; margin-bottom: .5rem; } input { width: 100%; min-width: 0; font: inherit; padding: .75rem; background: var(--bs-surface); color: var(--bs-text); border: 1px solid var(--bs-border); border-radius: 3px; } #search-status { margin-top: .75rem; color: var(--bs-muted); font-size: .9375rem; }
.search-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; } .search-results ul { list-style: none; padding: 0; max-width: 800px; } .search-results :global(li) { border-top: 1px solid var(--bs-line); padding-block: 1.5rem; } .search-results :global(a) { font-size: 1.375rem; font-weight: 600; } .search-results :global(p) { margin: .75rem 0 0; color: var(--bs-muted); } .search-results :global(.result-label) { font-size: .875rem; margin-bottom: .75rem; }
@media (max-width:900px) { .search-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } } @media (max-width:650px) { .search-grid { grid-template-columns: minmax(0,1fr); } }
</style>
